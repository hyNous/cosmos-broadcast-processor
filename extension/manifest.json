{
  "manifest_version": 3,
  "name": "小宇宙播客处理器",
  "version": "1.0.1",
  "description": "在小宇宙单集页面下载、裁剪、变速和调整音量。",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.xiaoyuzhoufm.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开小宇宙播客处理器"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
